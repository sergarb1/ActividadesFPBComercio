      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 14,
      "lineHeight": 1.25,
      "originalText": "Se cuenta por zonas y en orden, y se abre la caja: nunca se fía uno de la etiqueta.",
      "roughness": 1,
      "roundness": null,
      "strokeColor": "#1e1e1e",
