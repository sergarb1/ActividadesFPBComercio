      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 15,
      "lineHeight": 1.25,
      "originalText": "Diferencia = contado − teórico. Cada diferencia es dinero: venta sin registrar, hurto o merma.",
      "roughness": 1,
      "roundness": null,
      "strokeColor": "#0f766e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Diferencia = contado − teórico. Cada diferencia es dinero: venta sin registrar, hurto o merma.",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text23",
